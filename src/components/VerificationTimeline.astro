---
// Verification Timeline Component

interface Props {
  modelId: string;
  modelTitle: string;
  verificationHistory?: any[];
  timeframe?: number; // days
}

const { modelId, modelTitle, verificationHistory = [], timeframe = 30 } = Astro.props;

// Process history data for the specified timeframe
const cutoffDate = new Date();
cutoffDate.setDate(cutoffDate.getDate() - timeframe);

const recentHistory = verificationHistory
  .filter(entry => new Date(entry.timestamp) >= cutoffDate)
  .sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());

// Platform configuration
const platformConfig: Record<string, { icon: string; color: string; name: string }> = {
  github: { icon: '🐙', color: '#333333', name: 'GitHub' },
  reddit: { icon: '🤖', color: '#ff4500', name: 'Reddit' },
  hackernews: { icon: '🔥', color: '#ff6600', name: 'Hacker News' },
  stackoverflow: { icon: '📚', color: '#f48024', name: 'Stack Overflow' },
  huggingface: { icon: '🤗', color: '#ffd21e', name: 'Hugging Face' },
  discord: { icon: '💬', color: '#5865f2', name: 'Discord' },
  x: { icon: '🐦', color: '#1da1f2', name: 'X (Twitter)' }
};

// Get event type styling
const getEventStyling = (type: string) => {
  switch (type) {
    case 'verification_run':
      return { icon: '🔍', color: '#3b82f6', label: 'Verification' };
    case 'sentiment_change':
      return { icon: '📊', color: '#8b5cf6', label: 'Sentiment' };
    case 'issue_detected':
      return { icon: '⚠️', color: '#ef4444', label: 'Issue' };
    case 'availability_change':
      return { icon: '🔄', color: '#f59e0b', label: 'Availability' };
    default:
      return { icon: '📝', color: '#6b7280', label: 'Update' };
  }
};

// Calculate trend from score changes
const calculateTrend = () => {
  const scoreChanges = recentHistory
    .filter(entry => entry.data.newScore !== undefined && entry.data.previousScore !== undefined)
    .map(entry => entry.data.newScore - entry.data.previousScore);

  if (scoreChanges.length === 0) return { trend: 'stable', change: 0 };

  const totalChange = scoreChanges.reduce((sum, change) => sum + change, 0);
  const averageChange = totalChange / scoreChanges.length;

  let trend = 'stable';
  if (averageChange > 5) trend = 'improving';
  else if (averageChange < -5) trend = 'declining';

  return { trend, change: Math.round(totalChange) };
};

const trendData = calculateTrend();
---

<div id="verification-timeline-{modelId}" class="verification-timeline" style="display: none;">
  <div class="timeline-overlay" onclick="closeTimeline('{modelId}')"></div>
  <div class="timeline-content">
    <div class="timeline-header">
      <h2>Verification Timeline</h2>
      <button class="close-btn" onclick="closeTimeline('{modelId}')">×</button>
    </div>

    <div class="timeline-body">
      <!-- Model Info and Trend -->
      <div class="model-trend-summary">
        <div class="model-info">
          <h3>{modelTitle}</h3>
          <div class="trend-indicator" data-trend={trendData.trend}>
            <span class="trend-icon">
              {trendData.trend === 'improving' ? '📈' : trendData.trend === 'declining' ? '📉' : '➡️'}
            </span>
            <span class="trend-text">
              {trendData.trend === 'improving' ? 'Improving' : trendData.trend === 'declining' ? 'Declining' : 'Stable'}
              {trendData.change !== 0 && ` (${trendData.change > 0 ? '+' : ''}${trendData.change}%)`}
            </span>
          </div>
        </div>
        
        <div class="timeline-stats">
          <div class="stat-card">
            <span class="stat-number">{recentHistory.length}</span>
            <span class="stat-label">Events ({timeframe} days)</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">{new Set(recentHistory.map(e => e.platform)).size}</span>
            <span class="stat-label">Platforms</span>
          </div>
        </div>
      </div>

      <!-- Timeline -->
      {recentHistory.length > 0 ? (
        <div class="timeline-events">
          <h4>Recent Activity</h4>
          <div class="timeline-container">
            {recentHistory.map((entry: any, index: number) => {
              const eventStyling = getEventStyling(entry.type);
              const platform = platformConfig[entry.platform] || { icon: '🌐', color: '#6b7280', name: entry.platform };
              
              return (
                <div class="timeline-item" key={entry.id || index}>
                  <div class="timeline-marker" style={`background: ${eventStyling.color}`}>
                    <span class="marker-icon">{eventStyling.icon}</span>
                  </div>
                  
                  <div class="timeline-content-card">
                    <div class="event-header">
                      <div class="event-type" style={`color: ${eventStyling.color}`}>
                        <span>{eventStyling.icon}</span>
                        <span>{eventStyling.label}</span>
                      </div>
                      <div class="event-platform" style={`color: ${platform.color}`}>
                        <span>{platform.icon}</span>
                        <span>{platform.name}</span>
                      </div>
                    </div>
                    
                    <div class="event-time">
                      {new Date(entry.timestamp).toLocaleString()}
                    </div>
                    
                    {entry.data.scoreChange && (
                      <div class="score-change">
                        Score: {entry.data.previousScore || '?'}% → {entry.data.newScore}% 
                        <span class={`change-indicator ${entry.data.scoreChange > 0 ? 'positive' : entry.data.scoreChange < 0 ? 'negative' : 'neutral'}`}>
                          ({entry.data.scoreChange > 0 ? '+' : ''}{entry.data.scoreChange}%)
                        </span>
                      </div>
                    )}
                    
                    {entry.data.issues && entry.data.issues.length > 0 && (
                      <div class="detected-issues">
                        <span class="issues-label">Issues detected:</span>
                        <div class="issues-list">
                          {entry.data.issues.slice(0, 3).map((issue: string) => (
                            <span class="issue-tag">{issue}</span>
                          ))}
                          {entry.data.issues.length > 3 && (
                            <span class="issue-more">+{entry.data.issues.length - 3} more</span>
                          )}
                        </div>
                      </div>
                    )}
                    
                    {entry.data.availability && (
                      <div class="availability-change">
                        Status changed to: 
                        <span class={`availability-status ${entry.data.availability}`}>
                          {entry.data.availability.replace('_', ' ')}
                        </span>
                      </div>
                    )}
                    
                    {entry.data.mentionCount && (
                      <div class="mention-count">
                        {entry.data.mentionCount} new mentions found
                      </div>
                    )}
                    
                    {entry.metadata && (
                      <div class="event-metadata">
                        <details>
                          <summary>Additional Details</summary>
                          <pre>{JSON.stringify(entry.metadata, null, 2)}</pre>
                        </details>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="no-events">
          <div class="no-events-icon">📊</div>
          <h4>No Recent Activity</h4>
          <p>No verification events recorded in the last {timeframe} days.</p>
        </div>
      )}
      
      <!-- Platform Activity Summary -->
      <div class="platform-summary">
        <h4>Platform Activity Summary</h4>
        <div class="platform-activity-grid">
          {Array.from(new Set(recentHistory.map(e => e.platform))).map(platform => {
            const platformEvents = recentHistory.filter(e => e.platform === platform);
            const config = platformConfig[platform] || { icon: '🌐', color: '#6b7280', name: platform };
            
            return (
              <div class="platform-activity-card" style={`border-color: ${config.color}30`}>
                <div class="platform-header">
                  <span class="platform-icon" style={`color: ${config.color}`}>{config.icon}</span>
                  <span class="platform-name">{config.name}</span>
                </div>
                <div class="platform-stats">
                  <span class="event-count">{platformEvents.length} events</span>
                  <div class="event-types">
                    {Array.from(new Set(platformEvents.map(e => e.type))).slice(0, 2).map(type => {
                      const eventStyling = getEventStyling(type);
                      return (
                        <span class="mini-event-type" style={`color: ${eventStyling.color}`}>
                          {eventStyling.icon}
                        </span>
                      );
                    })}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <div class="timeline-footer">
      <button class="secondary-btn" onclick="closeTimeline('{modelId}')">Close</button>
      <select class="timeframe-select" onchange="updateTimelineTimeframe('{modelId}', this.value)">
        <option value="7" selected={timeframe === 7}>Last 7 days</option>
        <option value="30" selected={timeframe === 30}>Last 30 days</option>
        <option value="90" selected={timeframe === 90}>Last 90 days</option>
      </select>
    </div>
  </div>
</div>

<script>
  function closeTimeline(modelId) {
    const timeline = document.getElementById(`verification-timeline-${modelId}`);
    if (timeline) {
      timeline.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  }

  function updateTimelineTimeframe(modelId, timeframe) {
    // Reload the page with new timeframe parameter
    const url = new URL(window.location);
    url.searchParams.set('timeline', timeframe);
    url.searchParams.set('model', modelId);
    window.location.href = url.toString();
  }

  // Handle escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const timelines = document.querySelectorAll('.verification-timeline');
      timelines.forEach(timeline => {
        if (timeline.style.display === 'block') {
          timeline.style.display = 'none';
          document.body.style.overflow = 'auto';
        }
      });
    }
  });
</script>

